{
  "expo": {
    "name": "ViL AI Prompt Control",
    "slug": "vil-ai-prompt-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vilaipromptcontrol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vil.aipromptcontrol"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vil.aipromptcontrol"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ViL AI Prompt Control",
      "shortName": "ViL AI",
      "description": "Vasu Infosec — Material Requisition & Purchase Order System with AI Purchase Manager and role-based approvals.",
      "themeColor": "#0F172A",
      "backgroundColor": "#F8FAFC",
      "display": "standalone",
      "orientation": "any",
      "lang": "en",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
